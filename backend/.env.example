DB_HOST=DB_HOST
DB_PORT=DB_PORT
DB_USER=DB_USER
DB_PASSWORD=DB_PASSWORD
DB_NAME=DB_NAME
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
SERVER_PORT=BACKEND_PORT
# Comma-separated allowlist of origins, or "*" (discouraged outside dev).
CORS_ALLOWED_ORIGIN=FRONTEND_ORIGIN
TRUST_PROXY_HEADERS=false
TLS_CERT_FILE=
TLS_KEY_FILE=
API_MAX_BODY_BYTES=6291456
# Per-request deadline; a slow query or blocked lock can't pin a connection (B5).
REQUEST_TIMEOUT=20s
# Structured logging (B4): LOG_LEVEL=debug|info|warn|error, LOG_FORMAT=json|text.
LOG_LEVEL=info
LOG_FORMAT=json
# Cryptographic secrets — MUST be at least 32 characters each or the server
# refuses to start. Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_EXPIRY_MINUTES=15
MAX_CONCURRENT_PASSWORD_HASHES=2
PGP_ENCRYPTION_KEY=change-me-to-a-random-secret-of-at-least-32-bytes
BLIND_INDEX_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
HMAC_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
# ── Initial admin (used ONLY by the create_admin one-shot utility) ───────────
# Never hardcoded; create_admin fails if ADMIN_EMAIL/ADMIN_PASSWORD are unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Admin USBI
# ── SMTP: tutor double opt-in verification email (A1) ────────────────────────
# When SMTP_HOST is empty the server only LOGS the verification link (dev mode);
# tutor consent cannot actually be delivered. Set all of these for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=USBI <no-reply@usbi.edu.mx>
# true = implicit TLS (SMTPS, usually port 465); false = STARTTLS (usually 587).
SMTP_IMPLICIT_TLS=false
# Public base URL of THIS API, used to build the tutor verification link, e.g.
# https://usbi.edu.mx -> https://usbi.edu.mx/api/v1/auth/tutor-consent/verify
PUBLIC_API_BASE_URL=
TUTOR_CONSENT_TOKEN_TTL=24h
LEGAL_MAINTENANCE_ENABLED=false
LEGAL_MAINTENANCE_INTERVAL=24h
LEGAL_MAINTENANCE_BATCH_SIZE=100
PENDING_TUTOR_TTL=48h
INACTIVE_SUSPEND_AFTER=8760h
SUSPENDED_CANCEL_AFTER=720h
DB_PARTITION_MAINTENANCE_ENABLED=true
DB_PARTITION_MAINTENANCE_INTERVAL=24h
