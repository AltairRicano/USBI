DB_HOST=DB_HOST
DB_PORT=6432
DB_USER=usbi
DB_PASSWORD=replace-with-database-password
DB_NAME=usbi_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
# Only set to true once a reverse proxy in front of this service is confirmed
# to strip/set True-Client-IP, X-Real-IP and X-Forwarded-For itself.
SERVER_PORT=8088
CORS_ALLOWED_ORIGIN=https://usbi.example.edu
TRUST_PROXY_HEADERS=false
# Leave both empty when a reverse proxy (e.g. Nginx) terminates TLS in front
# of this service. Set both to serve HTTPS directly from this Go process.
TLS_CERT_FILE=
TLS_KEY_FILE=
API_MAX_BODY_BYTES=6291456
JWT_SECRET=replace-with-production-secret
JWT_ACCESS_EXPIRY_MINUTES=15
MAX_CONCURRENT_PASSWORD_HASHES=2
PGP_ENCRYPTION_KEY=replace-with-production-pgp-key
BLIND_INDEX_SECRET=replace-with-production-blind-index-secret
HMAC_SECRET=replace-with-production-hmac-secret
LEGAL_MAINTENANCE_ENABLED=true
LEGAL_MAINTENANCE_INTERVAL=24h
LEGAL_MAINTENANCE_BATCH_SIZE=100
PENDING_TUTOR_TTL=48h
INACTIVE_SUSPEND_AFTER=8760h
SUSPENDED_CANCEL_AFTER=720h
DB_PARTITION_MAINTENANCE_ENABLED=true
DB_PARTITION_MAINTENANCE_INTERVAL=24h
